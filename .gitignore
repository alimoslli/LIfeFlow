# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
/test-results/
/playwright-report/

# Python (situation simulator)
__pycache__/
*.pyc

# Situation cases: only scenario.json and persona.json are committed; validate.py and simulate.py rebuild the rest
# (worked examples in docs/situations/examples/ keep every file).
docs/situations/cases/*/connections/
docs/situations/cases/*/timeline.json
docs/situations/cases/*/truth.json

# Agent worktrees (builders work in these; their commits are merged, the folders are not)
.claude/worktrees/

# open models fetched by scripts/fetch-local-models.ts (pinned by hash, never committed)
.models/
