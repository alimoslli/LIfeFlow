# Copy to .env.local (for `npm run dev`) and .env (for scripts). Never commit real values.

# --- Database (PostgreSQL 15+) -------------------------------------------
# The role must NOT be a superuser and must NOT have BYPASSRLS, otherwise
# row-level security is silently skipped. `npm run db:check` verifies this.
DATABASE_URL=postgresql://budgetflow:budgetflow_dev@localhost:5432/budgetflow
TEST_DATABASE_URL=postgresql://budgetflow:budgetflow_dev@localhost:5432/budgetflow_test

# --- Security ------------------------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts third-party integration tokens at rest.
ENCRYPTION_KEY=

# --- Jarvis / OpenAI -------------------------------------------------------
# https://platform.openai.com/api-keys  (server-side only; never NEXT_PUBLIC_)
OPENAI_API_KEY=
# Any Responses-API model with function calling. Change without code edits.
OPENAI_MODEL=gpt-5.5
# Optional: reasoning effort for reasoning models (none|low|medium|high). Leave blank for model default.
OPENAI_REASONING_EFFORT=low
# Optional: OpenAI-compatible base URL (e.g. a gateway). Leave blank for api.openai.com.
OPENAI_BASE_URL=
# Optional: model prices in USD per 1M tokens, copied from your provider's pricing page.
# Used only for the cost estimate in Jarvis metrics; when blank, cost shows as "not configured".
JARVIS_PRICE_INPUT_PER_MTOK=
JARVIS_PRICE_CACHED_INPUT_PER_MTOK=
JARVIS_PRICE_OUTPUT_PER_MTOK=

# Live voice model (OpenAI Realtime). Default gpt-realtime.
OPENAI_REALTIME_MODEL=

# --- Google: Gmail + Google Calendar ----------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URI: https://<your-site>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your site's public URL (no trailing slash), so the redirect URI is exact.
APP_URL=

# --- Sign in with Apple -------------------------------------------------------
# developer.apple.com > Certificates, Identifiers & Profiles:
#  1. Identifiers > App ID with "Sign in with Apple" enabled.
#  2. Identifiers > Services ID (this is APPLE_CLIENT_ID, e.g. app.lifeflow.web) >
#     Configure: domain = your site, return URL = https://<your-site>/api/auth/apple/callback
#  3. Keys > new key with "Sign in with Apple" > download the .p8 once.
# Paste the whole .p8 file (BEGIN/END lines included) as APPLE_PRIVATE_KEY in Vercel.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Passkeys (Face ID / Touch ID) -------------------------------------------
# Passkeys are bound to APP_URL's domain. Optional: set a parent domain (e.g.
# lifeflow.app when the site is www.lifeflow.app). Changing it later makes
# existing passkeys stop working, so decide before people add them.
WEBAUTHN_RP_ID=

# --- Email (password reset links) --------------------------------------------
# https://resend.com > API Keys. EMAIL_FROM must be on a domain you verified there.
RESEND_API_KEY=
EMAIL_FROM=LifeFlow <no-reply@example.com>

# --- Legal pages -------------------------------------------------------------
# Shown in the Privacy Policy and Terms of Use. Leave blank for neutral wording.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_STATE=

# --- Plaid: bank, card, loan and investment sync (read-only) ---------------
# https://dashboard.plaid.com/developers/keys
# Start with PLAID_ENV=sandbox and the Sandbox secret (test bank: user_good / pass_good).
# For real banks, request Production access and use the Production secret.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Optional, needed for some banks that sign in with OAuth on phones:
# https://<your-site>/plaid-oauth (also add it under Allowed redirect URIs in the Plaid dashboard)
PLAID_REDIRECT_URI=

# --- Scheduled jobs (Vercel Cron or any scheduler) -------------------------
# Any long random string. Vercel sends it to /api/cron/sync and /api/cron/notify
# as "Authorization: Bearer <CRON_SECRET>". Generate: openssl rand -hex 32
CRON_SECRET=

# --- Push notifications (reminders, bills, morning brief, budget alerts) ----
# Generate a key pair once: npx web-push generate-vapid-keys
# The public key is sent to browsers; the private key stays on the server only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, e.g. mailto:you@example.com (defaults to LEGAL_CONTACT_EMAIL)
VAPID_SUBJECT=
# Vercel Hobby runs /api/cron/notify once a day (15:37 UTC). For reminders at the time
# you pick, call it every 10 minutes from a free scheduler such as cron-job.org:
#   GET https://<your-site>/api/cron/notify   Header: Authorization: Bearer <CRON_SECRET>

# --- Canvas (later milestone) ----------------------------------------------
# Your school's Canvas URL, e.g. https://canvas.myschool.edu
CANVAS_BASE_URL=

# --- Smart inbox (forward emails to Jarvis) --------------------------------------
# Each user gets u-<random>@<INBOX_DOMAIN>. Point the domain's MX records at an
# inbound email service (e.g. Postmark inbound) and set its webhook URL to
#   https://<your-site>/api/inbox/email?key=<INBOX_WEBHOOK_SECRET>
INBOX_DOMAIN=
# Any long random string. Generate: openssl rand -hex 32
INBOX_WEBHOOK_SECRET=
# Optional: model for live web searches (defaults to OPENAI_MODEL)
OPENAI_SEARCH_MODEL=
