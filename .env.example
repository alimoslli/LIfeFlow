# Copy to .env.local (for `npm run dev`) and .env (for scripts). Never commit real values.

# --- Database (PostgreSQL 15+) -------------------------------------------
# The role must NOT be a superuser and must NOT have BYPASSRLS, otherwise
# row-level security is silently skipped. `npm run db:check` verifies this.
DATABASE_URL=postgresql://budgetflow:budgetflow_dev@localhost:5432/budgetflow
TEST_DATABASE_URL=postgresql://budgetflow:budgetflow_dev@localhost:5432/budgetflow_test

# --- Security ------------------------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts third-party integration tokens at rest.
ENCRYPTION_KEY=

# --- Jarvis / OpenAI -------------------------------------------------------
# https://platform.openai.com/api-keys  (server-side only; never NEXT_PUBLIC_)
OPENAI_API_KEY=
# Any Responses-API model with function calling. Change without code edits.
OPENAI_MODEL=gpt-5.5
# Optional: how hard reasoning models think. auto (default) = low for quick lookups, medium for advice
# and plans, high for files and big plans. Or one fixed level: none|minimal|low|medium|high.
OPENAI_REASONING_EFFORT=auto
# Optional: how long OpenAI keeps the cached start of Jarvis's prompt (24h|in_memory). Default 24h.
OPENAI_PROMPT_CACHE_RETENTION=
# Optional: OpenAI-compatible base URL (e.g. a gateway). Leave blank for api.openai.com.
OPENAI_BASE_URL=
# Optional: model prices in USD per 1M tokens, copied from your provider's pricing page.
# Used only for the cost estimate in Jarvis metrics; when blank, cost shows as "not configured".
JARVIS_PRICE_INPUT_PER_MTOK=
JARVIS_PRICE_CACHED_INPUT_PER_MTOK=
JARVIS_PRICE_OUTPUT_PER_MTOK=
# Optional: the model each set of prices was copied for. A different running model then has an unknown cost instead of a wrong one.
# Blank: the prices belong to OPENAI_MODEL (and the SMALL ones to OPENAI_MODEL_SMALL).
JARVIS_PRICE_MODEL=
JARVIS_PRICE_SMALL_MODEL=
# Optional: the provider's fee in USD per 1,000 web searches. Blank: a search's cost is unknown (never guessed).
JARVIS_PRICE_WEB_SEARCH_PER_1K_CALLS=
# Company ceilings on paid AI in USD (they count only work whose cost is priced above). Blank: $50 a month and $10 a day.
# At 50% and 80% the owner gets an email (ALERT_EMAIL); at 100% the skyling pauses for everyone except admins.
AI_GLOBAL_MONTH_DOLLARS=
AI_GLOBAL_DAY_DOLLARS=
# Optional ceilings on the NUMBER of paid AI uses (for work with no price). Blank: none.
AI_GLOBAL_MONTH_CALLS=
AI_GLOBAL_DAY_CALLS=
# A Pro person's monthly AI allowance in USD after paid plans turn on. OFF (no per-person dollar limit) until the owner picks a number.
AI_PRO_MONTH_DOLLARS=

# Live voice model (OpenAI Realtime). Default gpt-realtime.
OPENAI_REALTIME_MODEL=

# --- Google: Sign in with Google, Gmail + Google Calendar ---------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URIs (add both):
#   https://<your-site>/api/integrations/google/callback   (Gmail + Calendar)
#   https://<your-site>/api/auth/google/callback            (Sign in with Google)
# Sign in with Google only asks for name and email; it appears once these and APP_URL are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your site's public URL (no trailing slash), so the redirect URI is exact.
APP_URL=

# --- Sign in with Apple -------------------------------------------------------
# developer.apple.com > Certificates, Identifiers & Profiles:
#  1. Identifiers > App ID with "Sign in with Apple" enabled.
#  2. Identifiers > Services ID (this is APPLE_CLIENT_ID, e.g. app.lifeflow.web) >
#     Configure: domain = your site, return URL = https://<your-site>/api/auth/apple/callback
#  3. Keys > new key with "Sign in with Apple" > download the .p8 once.
# Paste the whole .p8 file (BEGIN/END lines included) as APPLE_PRIVATE_KEY in Vercel.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Passkeys (Face ID / Touch ID) -------------------------------------------
# Passkeys are bound to APP_URL's domain. Optional: set a parent domain (e.g.
# lifeflow.app when the site is www.lifeflow.app). Changing it later makes
# existing passkeys stop working, so decide before people add them.
WEBAUTHN_RP_ID=

# --- Email (password reset links) --------------------------------------------
# https://resend.com > API Keys. EMAIL_FROM must be on a domain you verified there.
# Error alerts: crashes are grouped and the first of each kind is emailed here (falls back to LEGAL_CONTACT_EMAIL). Needs RESEND_API_KEY.
ALERT_EMAIL=
# Who may open /admin (comma separated sign-in emails). Leave empty to switch the admin page off (everyone gets a 404).
# The account must also have two-step sign-in (authenticator app) or a passkey turned on. See docs/adr/0022-admin-page.md.
ADMIN_EMAILS=
# Where Settings → Send feedback goes (falls back to ALERT_EMAIL, then LEGAL_CONTACT_EMAIL).
FEEDBACK_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=LifeFlow <no-reply@example.com>

# --- Legal pages -------------------------------------------------------------
# Shown in the Privacy Policy and Terms of Use. Leave blank for neutral wording.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_STATE=

# --- Plaid: bank, card, loan and investment sync (read-only) ---------------
# https://dashboard.plaid.com/developers/keys
# Start with PLAID_ENV=sandbox and the Sandbox secret (test bank: user_good / pass_good).
# For real banks, request Production access and use the Production secret.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Optional, needed for some banks that sign in with OAuth on phones:
# https://<your-site>/plaid-oauth (also add it under Allowed redirect URIs in the Plaid dashboard)
PLAID_REDIRECT_URI=

# --- Scheduled jobs (Vercel Cron or any scheduler) -------------------------
# Any long random string. Vercel sends it to /api/cron/sync and /api/cron/notify
# as "Authorization: Bearer <CRON_SECRET>". Generate: openssl rand -hex 32
CRON_SECRET=

# --- Push notifications (reminders, bills, morning brief, budget alerts) ----
# Generate a key pair once: npx web-push generate-vapid-keys
# The public key is sent to browsers; the private key stays on the server only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, e.g. mailto:you@example.com (defaults to LEGAL_CONTACT_EMAIL)
VAPID_SUBJECT=
# Vercel Hobby runs /api/cron/notify once a day (15:37 UTC). For reminders at the time
# you pick, call it every 10 minutes from a free scheduler such as cron-job.org:
#   GET https://<your-site>/api/cron/notify   Header: Authorization: Bearer <CRON_SECRET>

# --- Canvas (later milestone) ----------------------------------------------
# Your school's Canvas URL, e.g. https://canvas.myschool.edu
CANVAS_BASE_URL=

# --- Smart inbox (forward emails to Jarvis) --------------------------------------
# Each user gets u-<random>@<INBOX_DOMAIN>. Point the domain's MX records at an
# inbound email service (e.g. Postmark inbound) and set its webhook URL to
#   https://inbox:<INBOX_WEBHOOK_SECRET>@<your-site>/api/inbox/email
# (basic auth; the old ?key=<secret> form still works but is deprecated: it lands in access logs)
INBOX_DOMAIN=
# Any long random string. Generate: openssl rand -hex 32
INBOX_WEBHOOK_SECRET=
# Optional: model for live web searches (defaults to OPENAI_MODEL)
OPENAI_SEARCH_MODEL=

# --- Text Jarvis (SMS via Twilio) --------------------------------------------
# twilio.com > Console: Account SID and Auth Token, and a phone number that can send SMS.
# In the number's settings, set "A message comes in" to Webhook (HTTP POST):
#   https://<your-site>/api/sms/inbound
# APP_URL must match your site exactly (Twilio signs the full URL).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: an approved WhatsApp sender (E.164). Without it, WhatsApp replies come from TWILIO_PHONE_NUMBER.
TWILIO_WHATSAPP_NUMBER=

# --- LifeFlow Pro (Stripe) -----------------------------------------------------
# Until all three are set, every feature stays unlocked (handy while testing).
# dashboard.stripe.com > Products: create "LifeFlow Pro" with a monthly price; copy its price id.
# Developers > Webhooks: endpoint https://<your-site>/api/billing/webhook with events
#   checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- iPhone app (Capacitor) -------------------------------------------------------
# The production URL the App Store app loads (same as APP_URL). Used by `npm run ios` on a Mac.
CAP_SERVER_URL=

# Microsoft Teams and Outlook calendar (Microsoft Entra app registration; redirect URI <APP_URL>/api/integrations/microsoft/callback)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional; "common" lets school, work and personal accounts connect.
MICROSOFT_TENANT=common
